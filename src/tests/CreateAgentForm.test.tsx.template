    render(<CreateAgentForm />);
    const longName = 'A'.repeat(201);
    await userEvent.type(screen.getByTestId('name-input'), longName);

    await waitFor(() => {
      expect(screen.getByText(/must be 1-200 characters/i)).toBeInTheDocument();
    });
  });

  it('should auto-complete color field if selecting from palette', async () => {
    // PLAN:
    // 1. Render form
    // 2. Click on color palette button
    // 3. Select a predefined color
    // 4. Verify color field auto-filled

    render(<CreateAgentForm />);

    // Click on a predefined color option (if available)
    const colorOption = screen.getByTestId('color-option-teal');
    fireEvent.click(colorOption);

    expect(screen.getByTestId('color-input')).toHaveValue('#34D399');
  });
});

