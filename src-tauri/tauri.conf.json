{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Canopy",
  "version": "0.1.0",
  "identifier": "com.canopy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Canopy",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* ws://localhost:*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "orbstack",
          "cmd": "orb",
          "args": true
        },
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "docker-compose",
          "cmd": "docker-compose",
          "args": true
        }
      ]
    },
    "fs": {
      "scope": ["$APPDATA/**", "$HOME/.canopy/**"]
    }
  }
}
