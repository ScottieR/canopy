{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat-companion",
  "description": "Minimal event and window permissions for detached agent chat",
  "windows": [
    "chat_companion_*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
