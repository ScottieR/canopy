{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-popout",
  "description": "Event-only permissions for Canopy's local browser status window",
  "windows": [
    "browser_*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging"
  ]
}
