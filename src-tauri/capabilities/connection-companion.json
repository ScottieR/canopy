{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "connection-companion",
  "description": "Connection setup windows may open fixed provider URLs but cannot access files or dialogs",
  "windows": [
    "companion_*"
  ],
  "permissions": [
