# Public environment selection only. Runtime credentials belong in macOS Keychain.
VITE_API_URL=http://localhost:3001
# Optional: where static 3D/image assets are served from. Falls back to
# VITE_API_URL when unset (correct for local dev, where canopy-admin serves
# both). Production sets this to a GCS bucket instead — see .env.production.
VITE_ASSET_BASE_URL=
